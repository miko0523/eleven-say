# 复制成 .env 或写进你的 shell 配置，然后填上自己的值。不要把真钥匙提交进任何仓库。

# 必填：ElevenLabs 的 API 钥匙（二选一）
ELEVENLABS_API_KEY=your_api_key_here
# ELEVENLABS_API_KEY_FILE=~/.config/eleven-say/key

# 必填：嗓子 ID（ElevenLabs 网页 → Voices → 选中一个嗓子 → 复制 Voice ID）
ELEVENLABS_VOICE_ID=your_voice_id_here

# 选填
# ELEVENLABS_MODEL=eleven_v4      # 默认 v4，也可以 eleven_v3 等
# ELEVENLABS_TRIM_TAIL=auto       # auto = 只在 v3 上剪结尾杂音；on / off 强制

# 下面这些默认不发送，设了才发；哪个模型认哪个，自己试（不认的可能被忽略，也可能报 HTTP 422）
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_STYLE=0.0
# ELEVENLABS_SPEED_ZH=0.9
# ELEVENLABS_SPEED_EN=0.9
